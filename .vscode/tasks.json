{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    // Set the environment variable PZ_WORKSHOP_PATH to your Project Zomboid Workshop directory before running this task.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Deploy to Project Zomboid",
            "type": "shell",
            "command": "robocopy",
            "args": [
                "F:\\Mod Development\\Project-Zomboid\\EasyPacking",
                "C:\\Users\\Nekuromu\\Zomboid\\Workshop\\${workspaceFolderBasename}",
                "/MIR",
                "/XD", ".git", ".vscode",
                "/XF", ".gitignore", ".gitattributes", "README.md", "SteamDescription.txt", ".emmyrc.json",
                "/R:3",
                "/W:1"
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Project Zomboid (with Debug)",
            "type": "process",
            "command": "D:\\SteamLibrary\\steamapps\\common\\ProjectZomboid\\ProjectZomboid64.exe",
            "args": [
                "-debug",
            ],
            "options": {
                "cwd": "D:\\SteamLibrary\\steamapps\\common\\ProjectZomboid"
            },
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}